<Project Sdk="Microsoft.NET.Sdk">
  <!-- Issue #39: builds the real «Bobrov» ribbon tab with AdWindows outside AutoCAD, checks it and renders it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/AcadPaletteSetXData.Core/BobrovUi.cs" Link="BobrovUi.cs" />
    <Compile Include="../../src/AcadPaletteSetXData.AutoCAD/BobrovRibbon.cs" Link="BobrovRibbon.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- AdWindows.dll is a plain managed WPF library: unlike AcMgd it runs without AutoCAD, so its runtime asset is kept. -->
    <PackageReference Include="AutoCAD.NET" Version="24.0.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- The ribbon templates in AdWindows load Microsoft.Expression.Interactions (and System.Windows.Interactivity),
         which AutoCAD installs next to acad.exe; this package carries the same signed 4.5.0.0 assemblies for the check only. -->
    <PackageReference Include="The.Microsoft.Expression.Interactions" Version="4.5.0" />
  </ItemGroup>
</Project>
